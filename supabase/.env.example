# Server configuration. These values must never be placed in the Expo app.

# Supabase service role. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Hosted model provider key. Server only.
HOSTED_MODEL_KEY=

# Stripe secret key. Server only.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret. Server only.
STRIPE_WEBHOOK_SECRET=

# Stripe Price id for Plus, ₦1,500 per month. Server only.
STRIPE_PLUS_PRICE_ID=

# RevenueCat secret API key. Server only.
REVENUECAT_SECRET_KEY=

# RevenueCat webhook authorization secret. Server only.
REVENUECAT_WEBHOOK_SECRET=
