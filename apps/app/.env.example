# Client configuration for local, preview, and production.
# Leave the values empty. Do not put server secrets in this file.

# local, preview, or production. Defaults to local when empty.
APP_VARIANT=

# Supabase project URL. Safe to ship in the client.
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon key. Safe to ship in the client. This is not the service role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK key. Safe to ship in the client. This is not the RevenueCat secret.
EXPO_PUBLIC_REVENUECAT_SDK_KEY=

# Stripe publishable key. Safe to ship in the client. This is not the Stripe secret.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
